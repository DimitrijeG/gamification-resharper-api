<Window x:Class="ReSharperPlugin.ReSharperGamificationPlugin.Achievements.UIInteractive.Wpf.AchievementsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="clr-namespace:ReSharperPlugin.ReSharperGamificationPlugin.Achievements.UIInteractive"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance ui:AchievementsViewModel}"
        Title="Achievements" MaxHeight="500" Width="900">

  <Window.Resources>
    <ResourceDictionary>

      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GradeItemTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style TargetType="ListView">
        <Setter Property="Focusable" Value="False" />
        <!-- <Setter Property="IsHitTestVisible" Value="False" /> -->
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Border BorderBrush="LightGray"
                      BorderThickness="0,0,0,1"
                      Padding="5"
                      Margin="25,0">
                <GridViewRowPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Style>

    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <ListView ItemsSource="{Binding Achievements}">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="200">
            <GridViewColumn.CellTemplate>
              <DataTemplate DataType="{x:Type ui:AchievementItemViewModel}">

                <TextBlock Foreground="Black"
                           FontWeight="Medium"
                           FontSize="18"
                           TextAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text">
                        <Setter.Value>
                          <MultiBinding StringFormat="{}{0} ({1}/{2})">
                            <Binding Path="Title" />
                            <Binding Path="Unlocked" />
                            <Binding Path="Grades.Count" />
                          </MultiBinding>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>

          <GridViewColumn Width="600">
            <GridViewColumn.CellTemplate>
              <DataTemplate DataType="{x:Type ui:AchievementItemViewModel}">

                <ListView ItemsSource="{Binding Grades}"
                          ItemTemplate="{StaticResource GradeItemTemplate}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch">

                  <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListView.ItemsPanel>
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="Margin" Value="10" />
                      <Setter Property="Focusable" Value="False" />
                      <Setter Property="IsHitTestVisible" Value="False" />
                    </Style>
                  </ListView.ItemContainerStyle>
                </ListView>

              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </Grid>
</Window>