<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:ReSharperPlugin.ReSharperGamificationPlugin.Achievements.UIInteractive.Wpf.Converters"
  xmlns:ui="clr-namespace:ReSharperPlugin.ReSharperGamificationPlugin.Achievements.UIInteractive">

  <DataTemplate x:Key="GradeItemTemplate" DataType="{x:Type ui:GradeItemViewModel}">
    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Width="130">
      <Grid Width="90" Height="90">

        <!-- Ellipse for the fill, with clipping applied to progress percentage -->
        <Ellipse HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 Fill="{Binding Color, Converter={x:Static converters:ColorToBrushConverter.Instance}}"
                 Opacity="0.3">
          <Ellipse.Clip>
            <MultiBinding Converter="{x:Static converters:ProgressToRectangleGeometryConverter.Instance}">
              <Binding Path="Progress" />
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight" />
            </MultiBinding>
          </Ellipse.Clip>
        </Ellipse>

        <!-- Ellipse for the border -->
        <Ellipse HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 Stroke="{Binding Color, Converter={x:Static converters:ColorToBrushConverter.Instance}}"
                 StrokeThickness="2" />

        <!-- Image that dynamically uses a template with the specified name -->
        <Image VerticalAlignment="Center" HorizontalAlignment="Center"
               Width="60" Height="60">
          <Image.Style>
            <Style TargetType="Image">
              <!-- Default Image Source -->
              <Setter Property="Source">
                <Setter.Value>
                  <DrawingImage>
                    <DrawingImage.Drawing>
                      <DrawingGroup>
                        <DrawingGroup>
                          <DrawingGroup.ClipGeometry>
                            <RectangleGeometry Rect="0,0,20,20" />
                          </DrawingGroup.ClipGeometry>
                          <GeometryDrawing>
                            <GeometryDrawing.Brush>
                              <SolidColorBrush
                                Color="{Binding Color}" />
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                              <PathGeometry FillRule="Nonzero"
                                            Figures="M18.5,1L16,1 16,0.5C16,0.2,15.8,0,15.5,0L4.5,0C4.2,0,4,0.2,4,0.5L4,1 1.5,1C0.7,1,0,1.7,0,2.5L0,4.6C0,6.9 1.8,9 4.6,9 5.3,10.5 6.5,11.6 8,12.1L8,15 5.1,15C4.9,15,4.7,15.1,4.6,15.3L3,19.3C2.9,19.6,3.1,20,3.5,20L16.5,20C16.9,20,17.1,19.6,17,19.3L15.4,15.3C15.3,15.1,15.1,15,14.9,15L12,15 12,12.1C13.5,11.6 14.8,10.4 15.4,9 18.2,9 20,6.9 20,4.6L20,2.5C20,1.7,19.3,1,18.5,1z M2,4.6L2,3 4,3 4,7C2.9,6.8,2,5.8,2,4.6z M18,4.6C18,5.8,17.1,6.8,16,7L16,3 18,3z" />
                            </GeometryDrawing.Geometry>
                          </GeometryDrawing>
                        </DrawingGroup>
                      </DrawingGroup>
                    </DrawingImage.Drawing>
                  </DrawingImage>
                </Setter.Value>
              </Setter>

              <Style.Triggers>
                <!-- Case for MedalIcon -->
                <DataTrigger Binding="{Binding IconTemplate}" Value="medal">
                  <Setter Property="Source">
                    <Setter.Value>
                      <DrawingImage>
                        <DrawingImage.Drawing>
                          <DrawingGroup>
                            <DrawingGroup>
                              <DrawingGroup.ClipGeometry>
                                <RectangleGeometry Rect="0,0,24,24" />
                              </DrawingGroup.ClipGeometry>
                              <DrawingGroup.Transform>
                                <TranslateTransform X="-0" Y="5.551115123125783E-16" />
                              </DrawingGroup.Transform>
                              <DrawingGroup>
                                <GeometryDrawing>
                                  <GeometryDrawing.Brush>
                                    <SolidColorBrush
                                      Color="{Binding Color}" />
                                  </GeometryDrawing.Brush>
                                  <GeometryDrawing.Geometry>
                                    <PathGeometry FillRule="Nonzero"
                                                  Figures="M12.67,8.53C12.45,8.51 12.22,8.5 12,8.5 11.86,8.5 11.73,8.5 11.59,8.51 9.9,8.59 8.33,9.17 7.04,10.1L2.09,1.11C1.97,0.88 1.97,0.6 2.1,0.37 2.24,0.14 2.48,-0 2.75,-0L7.25,-0C7.52,-0,7.76,0.14,7.9,0.37L12.11,7.57z" />
                                  </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                              </DrawingGroup>
                              <DrawingGroup>
                                <GeometryDrawing>
                                  <GeometryDrawing.Brush>
                                    <SolidColorBrush
                                      Color="{Binding Color}" />
                                  </GeometryDrawing.Brush>
                                  <GeometryDrawing.Geometry>
                                    <PathGeometry FillRule="Nonzero"
                                                  Figures="M21.91,1.11L16.96,10.1C16.26,9.59,15.48,9.19,14.64,8.92L12.96,6.04 16.09,0.39C16.23,0.15,16.48,-0,16.75,-0L21.25,-0C21.52,-0 21.76,0.14 21.9,0.37 22.03,0.6 22.03,0.88 21.91,1.11z" />
                                  </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                              </DrawingGroup>
                              <DrawingGroup>
                                <GeometryDrawing>
                                  <GeometryDrawing.Brush>
                                    <SolidColorBrush
                                      Color="{Binding Color}" />
                                  </GeometryDrawing.Brush>
                                  <GeometryDrawing.Geometry>
                                    <PathGeometry FillRule="Nonzero"
                                                  Figures="M12,10C8.14,10 5,13.14 5,17 5,20.86 8.14,24 12,24 15.86,24 19,20.86 19,17 19,13.14 15.86,10 12,10z M15.787,16.757L14.426,18.152 14.749,20.13C14.795,20.413 14.676,20.698 14.44,20.864 14.312,20.954 14.16,21 14.009,21 13.884,21 13.759,20.969 13.646,20.906L12,19.997 10.354,20.907C10.103,21.046 9.793,21.03 9.559,20.864 9.324,20.698 9.205,20.413 9.25,20.13L9.573,18.152 8.212,16.757C8.016,16.556 7.948,16.261 8.038,15.995 8.127,15.728 8.357,15.535 8.636,15.492L10.487,15.209 11.321,13.432C11.567,12.905,12.432,12.905,12.678,13.432L13.512,15.209 15.363,15.492C15.641,15.534 15.872,15.728 15.961,15.995 16.051,16.261 15.983,16.556 15.787,16.757z" />
                                  </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                              </DrawingGroup>
                            </DrawingGroup>
                          </DrawingGroup>
                        </DrawingImage.Drawing>
                      </DrawingImage>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>

                <!-- Case for BeltIcon -->
                <DataTrigger Binding="{Binding IconTemplate}" Value="belt">
                  <Setter Property="Source">
                    <Setter.Value>
                      <DrawingImage>
                        <DrawingImage.Drawing>
                          <DrawingGroup>
                            <DrawingGroup>
                              <DrawingGroup.ClipGeometry>
                                <RectangleGeometry Rect="0,-128,512,512" />
                              </DrawingGroup.ClipGeometry>
                              <DrawingGroup.Transform>
                                <TranslateTransform X="-0" Y="128" />
                              </DrawingGroup.Transform>
                              <GeometryDrawing>
                                <GeometryDrawing.Brush>
                                  <SolidColorBrush Color="{Binding Color}" />
                                </GeometryDrawing.Brush>
                                <GeometryDrawing.Geometry>
                                  <PathGeometry FillRule="Nonzero"
                                                Figures="M296.8125,120L336.8164,0 175.1836,0 215.1875,120z M296.8125,120" />
                                </GeometryDrawing.Geometry>
                              </GeometryDrawing>
                              <GeometryDrawing>
                                <GeometryDrawing.Brush>
                                  <SolidColorBrush Color="{Binding Color}" />
                                </GeometryDrawing.Brush>
                                <GeometryDrawing.Geometry>
                                  <PathGeometry FillRule="Nonzero"
                                                Figures="M368.4414,0L358.8281,28.8398 434.7188,90 512,90 512,0z M368.4414,0" />
                                </GeometryDrawing.Geometry>
                              </GeometryDrawing>
                              <GeometryDrawing>
                                <GeometryDrawing.Brush>
                                  <SolidColorBrush Color="{Binding Color}" />
                                </GeometryDrawing.Brush>
                                <GeometryDrawing.Geometry>
                                  <PathGeometry FillRule="Nonzero"
                                                Figures="M153.1719,28.8398L143.5586,0 0,0 0,90 77.2813,90z M153.1719,28.8398" />
                                </GeometryDrawing.Geometry>
                              </GeometryDrawing>
                              <GeometryDrawing>
                                <GeometryDrawing.Brush>
                                  <SolidColorBrush Color="{Binding Color}" />
                                </GeometryDrawing.Brush>
                                <GeometryDrawing.Geometry>
                                  <PathGeometry FillRule="Nonzero"
                                                Figures="M318.4336,150L317.9297,150 450.6641,256.9766 508.1328,186.8867 348.7031,59.207z M318.4336,150" />
                                </GeometryDrawing.Geometry>
                              </GeometryDrawing>
                              <GeometryDrawing>
                                <GeometryDrawing.Brush>
                                  <SolidColorBrush Color="{Binding Color}" />
                                </GeometryDrawing.Brush>
                                <GeometryDrawing.Geometry>
                                  <PathGeometry FillRule="Nonzero"
                                                Figures="M60.3359,256.9766L194.0703,150 193.5664,150 163.2969,59.207 3.8672,186.8867z M60.3359,256.9766" />
                                </GeometryDrawing.Geometry>
                              </GeometryDrawing>
                            </DrawingGroup>
                          </DrawingGroup>
                        </DrawingImage.Drawing>
                      </DrawingImage>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>

                <!-- Case for RingIcon -->
                <DataTrigger Binding="{Binding IconTemplate}" Value="ring">
                  <Setter Property="Source">
                    <Setter.Value>
                      <DrawingImage>
                        <DrawingImage.Drawing>
                          <DrawingGroup>
                            <DrawingGroup>
                              <DrawingGroup.ClipGeometry>
                                <RectangleGeometry Rect="0,0,100,100" />
                              </DrawingGroup.ClipGeometry>
                              <GeometryDrawing>
                                <GeometryDrawing.Brush>
                                  <SolidColorBrush Color="{Binding Color}" />
                                </GeometryDrawing.Brush>
                                <GeometryDrawing.Geometry>
                                  <PathGeometry FillRule="Nonzero"
                                                Figures="M14.375,61.875C14.375,82.3856 31.7067,98.8469 52.524,97.4129 70.225,96.1936 84.5093,81.7589 85.5604,64.0472 86.5702,47.0326 75.6276,32.412 60.3443,27.7807L71.8098,16.3152C72.8813,15.2437,72.8813,13.5063,71.8098,12.4348L62.6787,3.3037C62.1641,2.7891,61.4662,2.5,60.7384,2.5L39.2616,2.5C38.5338,2.5,37.8359,2.7891,37.3213,3.3037L28.1902,12.4348C27.1187,13.5063,27.1187,15.2437,28.1902,16.3152L39.6557,27.7807C25.0269,32.2136,14.375,45.7986,14.375,61.875z M50,38.125C63.1171,38.125 73.75,48.7579 73.75,61.875 73.75,74.9921 63.1171,85.625 50,85.625 36.8829,85.625 26.25,74.9921 26.25,61.875 26.25,48.7579 36.8829,38.125 50,38.125z" />
                                </GeometryDrawing.Geometry>
                              </GeometryDrawing>
                            </DrawingGroup>
                          </DrawingGroup>
                        </DrawingImage.Drawing>
                      </DrawingImage>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Image.Style>
        </Image>
      </Grid>

      <!-- TextBlock for caption displaying grade title and optionally progress -->
      <TextBlock Foreground="{Binding Color, Converter={x:Static converters:ColorToBrushConverter.Instance}}"
                 MaxWidth="130"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 FontSize="13"
                 FontWeight="Medium">

        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text">
              <Setter.Value>
                <MultiBinding StringFormat="{}{0} ({1:0}%)">
                  <Binding Path="Title" />
                  <Binding Path="Progress" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Unlocked}" Value="True">
                <Setter Property="Text" Value="{Binding Title}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

    </StackPanel>
  </DataTemplate>
</ResourceDictionary>